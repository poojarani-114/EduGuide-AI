# Server Port
PORT=5000

# Secret key for signing JWT tokens (generate a strong random string for production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database Connection URL
# For SQLite (local / persistent volume):
DATABASE_URL="file:./dev.db"

# For PostgreSQL (e.g., Neon, Supabase, Render Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/eduguide?sslmode=require"
